<?xml version="1.0" encoding="utf-8"?>
<!-- Schéma de contrôle du parallélisme : deux brides avec un écart de mesure en haut (A)
     et en bas (B). Diagramme simplifié en attendant l'image d'origine (voir README). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="60dp"
    android:viewportWidth="160"
    android:viewportHeight="100">

    <!-- Tube gauche -->
    <path android:pathData="M0,42 L58,42 L58,58 L0,58 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Bride gauche (droite) -->
    <path android:pathData="M52,14 L80,14 L80,86 L52,86 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Bride droite (légèrement inclinée : simule un défaut de parallélisme) -->
    <path android:pathData="M88,18 L112,10 L104,90 L80,82 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Tube droit -->
    <path android:pathData="M104,34 L160,40 L160,58 L104,52 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>

    <!-- Flèche de mesure haute (A) -->
    <path android:pathData="M80,10 L88,10 M80,10 L83,7 M80,10 L83,13 M88,10 L85,7 M88,10 L85,13" android:strokeColor="@color/primary" android:strokeWidth="1.6" android:fillColor="#00000000"/>
    <!-- Flèche de mesure basse (B) -->
    <path android:pathData="M80,90 L104,90 M80,90 L83,87 M80,90 L83,93 M104,90 L101,87 M104,90 L101,93" android:strokeColor="@color/primary" android:strokeWidth="1.6" android:fillColor="#00000000"/>
</vector>
