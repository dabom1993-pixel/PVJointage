<?xml version="1.0" encoding="utf-8"?>
<!-- Schéma de contrôle de l'excentration : deux brides décalées, avec la mesure du
     décalage (A) en haut. Diagramme simplifié en attendant l'image d'origine (voir README). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="60dp"
    android:viewportWidth="160"
    android:viewportHeight="100">

    <!-- Tube gauche -->
    <path android:pathData="M0,34 L58,34 L58,50 L0,50 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Bride gauche -->
    <path android:pathData="M52,8 L80,8 L80,78 L52,78 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Bride droite (décalée vers le bas : simule une excentration) -->
    <path android:pathData="M84,28 L112,28 L112,96 L84,96 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>
    <!-- Tube droit -->
    <path android:pathData="M106,54 L160,54 L160,70 L106,70 Z" android:fillColor="@color/row_alt" android:strokeColor="@color/primary" android:strokeWidth="1.5"/>

    <!-- Flèche de mesure du décalage (A), entre le haut des deux brides -->
    <path android:pathData="M96,8 L96,26 M96,8 L93,11 M96,8 L99,11 M96,26 L93,23 M96,26 L99,23" android:strokeColor="@color/primary" android:strokeWidth="1.6" android:fillColor="#00000000"/>
</vector>
