<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp" />

        <!-- Schéma optionnel (parallélisme / excentration), juste à côté du libellé : reste
             dans la zone flexible du libellé pour que les boutons C/NC/A restent alignés
             avec ceux des autres lignes, qu'un schéma soit présent ou non. -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="70dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOui"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="46dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/oui"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnNon"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="46dp"
        android:layout_marginStart="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/non"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnAutre"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="46dp"
        android:layout_marginStart="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/autre"
        android:textSize="15sp" />

</LinearLayout>
