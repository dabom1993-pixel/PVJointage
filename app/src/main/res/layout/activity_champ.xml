<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:padding="4dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_adf"
                    android:contentDescription="@string/app_name" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_champ"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvContexte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="@color/primary_dark"/>

            <!-- Révision de l'item de cette bride : visible seulement s'il a été modifié après
                 un export PDF (traçabilité, voir Repository.touchItemRevision). -->
            <TextView
                android:id="@+id/tvItemRevision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@color/accent"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="REV 1"
                tools:visibility="visible"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"/>

            <!-- ETIQUETTE -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/section_etiquette" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvStatutEtiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:padding="4dp" android:textSize="16sp"/>
                    </LinearLayout>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selEtiMiseSerree" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selEtiNomDate" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- JOINT -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/section_joint" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvStatutJoint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:padding="4dp" android:textSize="16sp"/>
                    </LinearLayout>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selJointDimension" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selJointMatiere" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selJointAspect" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOULONNERIE -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/section_boulonnerie" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvStatutBoulonnerie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:padding="4dp" android:textSize="16sp"/>
                    </LinearLayout>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonNeuves" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonRondelles" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonEquilibrage" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonGraissage" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonLongueur" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selBoulonMatiere" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ASSEMBLAGE -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/section_assemblage" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp"/>
                        <TextView android:id="@+id/tvStatutAssemblage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:padding="4dp" android:textSize="16sp"/>
                    </LinearLayout>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selAssemblageParallelisme" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <com.adf.pvjointage.ui.EtatSelectorView android:id="@+id/selAssemblageExcentration" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- REMARQUE -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_remarque" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp" android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etRemarque"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minLines="2"
                        android:textSize="15sp"
                        android:hint="@string/remarque_hint"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PHOTO -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_photo" android:textStyle="bold" android:textColor="@color/primary" android:textSize="17sp" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Les photos sont propres à cette bride (repère)." android:textSize="14sp" android:layout_marginBottom="8dp"/>
                    <Button
                        android:id="@+id/btnPrendrePhoto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_prendre_photo"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPhotos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
