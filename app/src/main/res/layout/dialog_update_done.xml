<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Bouton pleine largeur : le bouton par défaut d'AlertDialog tronque ce texte long
         (largeur limitée à la barre de boutons) et le passe en MAJUSCULES (thème
         MaterialComponents). On utilise donc un bouton dédié, sans cette contrainte. -->
    <Button
        android:id="@+id/btnMajTermine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/maj_termine_bouton" />

</LinearLayout>
