<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etRepere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_repere_hint"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_designation_hint"
            android:inputType="textCapSentences"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etDn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ajouter_bride_dn_hint"
                android:inputType="text"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etPn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ajouter_bride_pn_hint"
                android:inputType="text"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etMatiereJoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_matiere_joint_hint"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etRondelle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_rondelle_hint"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etMatiereBoulon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_matiere_boulon_hint"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etLongueurBoulon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ajouter_bride_longueur_hint"
                android:inputType="text"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etDiametreBoulon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ajouter_bride_diametre_hint"
                android:inputType="text"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNeufBoulon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ajouter_bride_neuf_hint"
            android:inputType="text" />

    </LinearLayout>
</ScrollView>
